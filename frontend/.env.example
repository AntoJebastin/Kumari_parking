# Kumari Parking Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER put secret keys (Razorpay Secret, Resend API Key, Supabase Service Role Key) here!

# FastAPI Backend Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Supabase Public Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps JavaScript API Key (Browser-restricted)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Razorpay Public Key ID (Test Mode: rzp_test_...)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Application Metadata
VITE_APP_NAME=Kumari Parking
VITE_APP_URL=http://localhost:5173
